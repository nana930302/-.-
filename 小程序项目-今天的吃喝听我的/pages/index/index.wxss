/* pages/index/index.wxss */

.index-container {
  width: 100%;
  min-height: 100vh;
  background: linear-gradient(135deg, #FFF5E6 0%, #FFE4E1 50%, #F0E6FF 100%);
  display: flex;
  flex-direction: column;
}

.header {
  background: linear-gradient(135deg, #FF6B9D 0%, #FF8FAB 100%);
  padding: 40rpx 20rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 157, 0.2);
}

.header-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #ffffff;
  text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.1);
}

.content {
  flex: 1;
  padding: 30rpx 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #FF6B9D;
  margin-bottom: 20rpx;
  padding-left: 10rpx;
}

/* 推荐区域 */
.recommend-section {
  margin-bottom: 40rpx;
}

.recommend-cards {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.recommend-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
}

.recommend-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.1);
}

.card-avatar {
  font-size: 60rpx;
  margin-right: 16rpx;
}

.card-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.card-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 4rpx;
}

.card-desc {
  font-size: 20rpx;
  color: #999999;
}

.card-arrow {
  font-size: 36rpx;
  color: #CCCCCC;
  margin-left: 12rpx;
}

.cat-recommend {
  border-left: 4rpx solid #FF9F5A;
}

.dog-recommend {
  border-left: 4rpx solid #A0522D;
}

/* 功能部分 */
.feature-section {
  margin-bottom: 40rpx;
}

.feature-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.feature-item {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
}

.feature-item:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.1);
}

.feature-icon {
  font-size: 56rpx;
  display: block;
  margin-bottom: 12rpx;
}

.feature-name {
  font-size: 24rpx;
  color: #333333;
  font-weight: 500;
}

/* 页脚 */
.footer {
  padding: 20rpx;
  text-align: center;
  background: rgba(255, 107, 157, 0.1);
  margin-top: auto;
}

.footer-text {
  font-size: 20rpx;
  color: #999999;
}

/* 响应式设计 */
@media (max-width: 320px) {
  .header-title {
    font-size: 32rpx;
  }
  
  .section-title {
    font-size: 28rpx;
  }
  
  .card-name {
    font-size: 24rpx;
  }
  
  .feature-grid {
    grid-template-columns: 1fr;
  }
}
