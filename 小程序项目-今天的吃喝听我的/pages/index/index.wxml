<view class="index-container">
  <view class="header">
    <text class="header-title">今天的吃喝听我的</text>
  </view>

  <view class="content">
    <!-- 服务员推荐区域 -->
    <view class="recommend-section">
      <view class="section-title">来自小猫和小狗的推荐</view>
      
      <view class="recommend-cards">
        <!-- 喵喵的推荐 -->
        <view class="recommend-card cat-recommend">
          <view class="card-avatar">
            <text class="avatar-emoji">🐱</text>
          </view>
          <view class="card-content">
            <text class="card-name">喵喵的午餐推荐</text>
            <text class="card-desc">今天吃点清淡的吧</text>
          </view>
          <view class="card-arrow">›</view>
        </view>

        <!-- 汪汪的推荐 -->
        <view class="recommend-card dog-recommend">
          <view class="card-avatar">
            <text class="avatar-emoji">🐶</text>
          </view>
          <view class="card-content">
            <text class="card-name">汪汪的晚餐推荐</text>
            <text class="card-desc">晚餐要吃饱饱哦</text>
          </view>
          <view class="card-arrow">›</view>
        </view>
      </view>
    </view>

    <!-- 功能入口 -->
    <view class="feature-section">
      <view class="section-title">功能菜单</view>
      
      <view class="feature-grid">
        <view class="feature-item">
          <view class="feature-icon">🍽️</view>
          <text class="feature-name">随机推荐</text>
        </view>
        <view class="feature-item">
          <view class="feature-icon">❤️</view>
          <text class="feature-name">我的收藏</text>
        </view>
        <view class="feature-item">
          <view class="feature-icon">⭐</view>
          <text class="feature-name">评分排行</text>
        </view>
        <view class="feature-item">
          <view class="feature-icon">⚙️</view>
          <text class="feature-name">设置</text>
        </view>
      </view>
    </view>
  </view>

  <view class="footer">
    <text class="footer-text">由喵喵和汪汪为您服务</text>
  </view>
</view>
