.splash {
  min-height: 100vh;
  padding: 72rpx 28rpx 56rpx;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}

.halo {
  position: absolute;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  filter: blur(28rpx);
  opacity: 0.45;
}

.halo-left {
  left: -80rpx;
  top: 120rpx;
  background: rgba(255, 170, 120, 0.8);
}

.halo-right {
  right: -100rpx;
  top: 340rpx;
  background: rgba(255, 227, 131, 0.76);
}

.title {
  width: 280rpx;
  margin: 12rpx auto 36rpx;
  display: block;
  position: relative;
  z-index: 2;
}

.hero {
  width: 100%;
  border-radius: 56rpx;
  display: block;
  position: relative;
  z-index: 2;
  box-shadow: 0 24rpx 44rpx rgba(177, 89, 26, 0.18);
}

.intro {
  margin-top: 28rpx;
  padding: 36rpx 34rpx 40rpx;
  position: relative;
  z-index: 2;
}

.intro-title {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  margin-bottom: 14rpx;
}

.intro-desc {
  display: block;
  font-size: 28rpx;
  line-height: 1.7;
  color: #9c6535;
}

.enter-btn {
  position: relative;
  z-index: 2;
  width: 100%;
  height: 92rpx;
  margin-top: 28rpx;
  border: none;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #ff7f4d, #ff5a38);
  color: #fff8ef;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 18rpx 30rpx rgba(255, 107, 61, 0.25);
}
