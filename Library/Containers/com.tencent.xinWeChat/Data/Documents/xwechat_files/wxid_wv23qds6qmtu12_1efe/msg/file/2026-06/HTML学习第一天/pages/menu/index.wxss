.menu-head {
  flex: 1;
  text-align: center;
}

.menu-panel {
  padding: 30rpx;
  margin-bottom: 24rpx;
  background:
    linear-gradient(180deg, rgba(255, 250, 242, 0.98), rgba(255, 241, 219, 0.96));
}

.menu-panel__banner {
  margin-bottom: 22rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: rgba(91, 37, 12, 0.08);
}

.menu-panel__banner-title,
.menu-panel__banner-desc {
  display: block;
}

.menu-panel__banner-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #6a3112;
  margin-bottom: 10rpx;
}

.menu-panel__banner-desc {
  font-size: 24rpx;
  line-height: 1.6;
  color: #945f34;
}

.menu-panel__banner-btn {
  margin-top: 18rpx;
}

.filter-bar {
  margin-bottom: 22rpx;
  padding: 22rpx 22rpx 18rpx;
  border-radius: 28rpx;
  background: rgba(255, 248, 239, 0.68);
}

.filter-block {
  margin-bottom: 18rpx;
}

.filter-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #8e5a30;
}

.filter-scroll {
  width: 100%;
  white-space: nowrap;
}

.filter-pills {
  display: inline-flex;
  gap: 12rpx;
}

.filter-pill,
.sort-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 237, 214, 0.9);
  color: #905728;
  font-size: 22rpx;
}

.filter-pill--active,
.sort-chip--active {
  background: linear-gradient(180deg, #ff8a58, #ff6b3d);
  color: #fff8ef;
  font-weight: 700;
}

.sort-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.sort-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  justify-content: flex-end;
}

.menu-panel__row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.menu-panel__btn {
  flex-shrink: 0;
}

.menu-cards {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.menu-card {
  border-radius: 28rpx;
  padding: 24rpx;
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.44),
    0 10rpx 22rpx rgba(149, 79, 24, 0.08);
}

.menu-card__topline {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.menu-card__chip,
.menu-card__fav {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 248, 239, 0.68);
  color: #7d4316;
  font-size: 20rpx;
  font-weight: 700;
}

.menu-card__name {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: #58220c;
  margin-bottom: 10rpx;
}

.menu-card__tip {
  display: block;
  font-size: 24rpx;
  line-height: 1.7;
  color: rgba(88, 34, 12, 0.76);
}

.menu-card__actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.menu-card__btn,
.menu-card__ghost {
  flex: 1;
}

.menu-load {
  padding: 12rpx 0 6rpx;
  text-align: center;
}

.menu-load__text {
  display: block;
  font-size: 24rpx;
  color: #a06a3d;
}
