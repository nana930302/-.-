.hero {
  overflow: hidden;
  background:
    radial-gradient(circle at 88% 14%, rgba(255, 213, 123, 0.32), transparent 22%),
    linear-gradient(180deg, rgba(255, 249, 242, 0.98), rgba(255, 241, 219, 0.96));
}

.hero__scene {
  width: 100%;
  display: block;
}

.hero__content {
  padding: 30rpx 30rpx 34rpx;
  position: relative;
}

.hero__eyebrow {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 128, 79, 0.12);
  font-size: 22rpx;
  color: #c05f32;
  margin-bottom: 14rpx;
}

.hero__title {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  margin-bottom: 14rpx;
}

.hero__desc {
  display: block;
  font-size: 26rpx;
  line-height: 1.7;
  color: #965f33;
}

.hero__actions {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 24rpx;
}

.hero__btn {
  width: 100%;
}

.metrics {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 24rpx;
}

.metric {
  padding: 28rpx;
  text-align: center;
  background:
    linear-gradient(180deg, rgba(255, 252, 247, 0.96), rgba(255, 241, 220, 0.94));
}

.metric__num {
  display: block;
  font-size: 54rpx;
  font-weight: 800;
  color: #ff6b3d;
  margin-bottom: 8rpx;
}

.metric__label {
  font-size: 24rpx;
  color: #9d693b;
}

.menu,
.section-card {
  margin-top: 24rpx;
  padding: 30rpx;
}

.quick-note {
  margin-top: 24rpx;
  padding: 28rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  background:
    linear-gradient(135deg, rgba(255, 246, 233, 0.98), rgba(255, 237, 207, 0.96));
}

.quick-note__btn {
  min-width: 180rpx;
}

.menu__grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 24rpx;
}

.menu__item {
  border: none;
  border-radius: 28rpx;
  padding: 26rpx 24rpx 28rpx;
  text-align: left;
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.45),
    0 12rpx 24rpx rgba(155, 84, 32, 0.1);
}

.menu__icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 16rpx;
  border-radius: 50%;
  background: rgba(255, 248, 239, 0.72);
  color: #6b2d10;
  font-size: 24rpx;
  font-weight: 800;
}

.menu__title {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: #59210a;
  margin-bottom: 10rpx;
}

.menu__desc {
  display: block;
  font-size: 22rpx;
  line-height: 1.6;
  color: rgba(89, 33, 10, 0.78);
}

.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.small-btn {
  min-width: 120rpx;
}

.history-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(155, 88, 31, 0.1);
}

.history-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.history-item__name {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
}

.history-item__tip {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #9c683a;
  max-width: 460rpx;
}

.history-item__type {
  font-size: 22rpx;
  color: #b27039;
  flex-shrink: 0;
  margin-left: 24rpx;
}
