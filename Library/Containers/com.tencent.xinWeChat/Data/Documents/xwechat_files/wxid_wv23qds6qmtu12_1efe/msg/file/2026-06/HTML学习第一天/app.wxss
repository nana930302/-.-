page {
  min-height: 100%;
  background:
    radial-gradient(circle at 18% 8%, rgba(255, 255, 255, 0.8), transparent 24%),
    linear-gradient(180deg, #fff4dc, #ffd391);
  color: #5b250c;
  font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
}

button::after {
  border: none;
}

.shell {
  min-height: 100vh;
  padding: 44rpx 28rpx 180rpx;
  box-sizing: border-box;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.topbar__title {
  font-size: 48rpx;
  font-weight: 800;
  color: #4d250d;
}

.topbar__subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #a56e3f;
}

.topbar__ghost {
  width: 88rpx;
}

.ghost-btn,
.primary-btn,
.secondary-btn {
  border: none;
  border-radius: 999rpx;
  font-size: 28rpx;
  line-height: 1;
  overflow: hidden;
}

.ghost-btn {
  min-width: 88rpx;
  height: 72rpx;
  background: rgba(255, 248, 239, 0.9);
  color: #9d612d;
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.8),
    0 10rpx 24rpx rgba(168, 88, 26, 0.1);
}

.card {
  background: rgba(255, 248, 239, 0.92);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 40rpx;
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.82),
    0 14rpx 34rpx rgba(168, 88, 26, 0.12);
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.section-desc {
  font-size: 24rpx;
  line-height: 1.6;
  color: #9a6739;
}

.primary-btn {
  height: 86rpx;
  padding: 0 36rpx;
  background: linear-gradient(180deg, #ff7f4d, #ff5a38);
  color: #fff8ef;
  font-weight: 700;
  box-shadow:
    inset 0 2rpx 0 rgba(255, 229, 220, 0.48),
    0 16rpx 30rpx rgba(255, 107, 61, 0.24);
}

.secondary-btn {
  height: 86rpx;
  padding: 0 36rpx;
  background: rgba(255, 237, 214, 0.95);
  color: #9b581f;
  font-weight: 700;
  box-shadow:
    inset 0 2rpx 0 rgba(255, 255, 255, 0.62),
    0 12rpx 24rpx rgba(168, 88, 26, 0.08);
}

.empty-card {
  padding: 42rpx 32rpx;
  text-align: center;
}

.empty-card text {
  display: block;
}

.bottom-nav {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 26rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 20rpx calc(18rpx + env(safe-area-inset-bottom));
  border-radius: 999rpx;
  background: rgba(91, 37, 12, 0.88);
  box-shadow: 0 18rpx 40rpx rgba(91, 37, 12, 0.24);
  z-index: 30;
  backdrop-filter: blur(16rpx);
}

.bottom-nav__item {
  flex: 1;
  border: none;
  background: transparent;
  color: rgba(255, 245, 232, 0.72);
  font-size: 24rpx;
  line-height: 1.3;
  padding: 12rpx 0;
}

.bottom-nav__item--active {
  color: #fff8ef;
  font-weight: 700;
}

.pill-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.pill {
  padding: 18rpx 24rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #6a3112;
  background: rgba(255, 236, 210, 0.85);
}

.tone-pink {
  background: linear-gradient(135deg, #ff8db0, #ffb7d2);
}

.tone-lime {
  background: linear-gradient(135deg, #cce66d, #f2f28a);
}

.tone-blue {
  background: linear-gradient(135deg, #7cc8ff, #b8e4ff);
}

.tone-orange {
  background: linear-gradient(135deg, #ffc06c, #ffd894);
}

.tone-purple {
  background: linear-gradient(135deg, #b8a4ff, #dbcfff);
}

.tone-coral {
  background: linear-gradient(135deg, #ff9f71, #ffc195);
}
