page {
  min-height: 100%;
  background: linear-gradient(180deg, #fff4dc, #ffd391);
}

.page {
  position: relative;
  min-height: 100vh;
  padding: 44rpx 28rpx 48rpx;
  background:
    radial-gradient(circle at 20% 8%, rgba(255, 255, 255, 0.8), transparent 24%),
    linear-gradient(180deg, #fff4dc, #ffd391);
  color: #5b250c;
}

.stage {
  position: relative;
  width: 100%;
  aspect-ratio: 1306 / 1205;
}

.scene {
  width: 100%;
  border-radius: 56rpx;
}

.bowl-mask {
  position: absolute;
  left: 13.3%;
  top: 40.1%;
  width: 56.6%;
  height: 23.1%;
  border-radius: 46% 46% 34% 34% / 38% 38% 26% 26%;
  overflow: hidden;
}

.bowl-fade {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at 50% 44%, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0) 60%, rgba(255, 255, 255, 0.04)),
    linear-gradient(180deg, rgba(255, 245, 238, 0.04), rgba(255, 221, 195, 0.04));
  z-index: 1;
}

.tag-layer {
  position: absolute;
  inset: 0;
  z-index: 2;
  filter: saturate(1.02) contrast(1.01);
}

.tag {
  position: absolute;
  width: 34%;
  clip-path: polygon(7% 28%, 17% 10%, 84% 2%, 96% 20%, 94% 77%, 83% 96%, 14% 92%, 3% 72%);
}

.tag.result {
  z-index: 4;
}

.flying-tag {
  position: absolute;
  width: 32%;
  z-index: 9;
  clip-path: polygon(7% 28%, 17% 10%, 84% 2%, 96% 20%, 94% 77%, 83% 96%, 14% 92%, 3% 72%);
}

.start-hit {
  position: absolute;
  left: 34.2%;
  top: 73.8%;
  width: 25%;
  height: 15%;
}

.result-card {
  margin-top: 36rpx;
  background: rgba(255, 248, 239, 0.92);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 56rpx;
  padding: 36rpx 36rpx 44rpx;
  box-shadow: 0 14rpx 34rpx rgba(168, 88, 26, 0.16);
  display: flex;
  flex-direction: column;
}

.result-label {
  font-size: 28rpx;
  color: #b86b31;
  margin-bottom: 16rpx;
}

.result-name {
  font-size: 60rpx;
  line-height: 1.2;
  font-weight: 800;
  color: #ff6b3d;
  margin-bottom: 16rpx;
}

.result-tip {
  font-size: 30rpx;
  line-height: 1.6;
  color: #7f4a20;
}
