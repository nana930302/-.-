.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.stat {
  padding: 30rpx 24rpx;
  text-align: center;
}

.stat__num {
  display: block;
  font-size: 52rpx;
  font-weight: 800;
  color: #ff6b3d;
  margin-bottom: 8rpx;
}

.stat__label {
  font-size: 24rpx;
  color: #9c6637;
}

.profile-actions,
.profile-history,
.profile-hero {
  margin-top: 24rpx;
  padding: 30rpx;
}

.profile-hero__pills {
  margin-top: 18rpx;
}

.profile-actions__buttons {
  display: flex;
  gap: 18rpx;
  margin-top: 20rpx;
}

.profile-actions__buttons button {
  flex: 1;
}

.profile-actions__ghost {
  width: 100%;
}

.profile-history__item {
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(155, 88, 31, 0.1);
}

.profile-history__item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.profile-history__name {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.profile-history__type {
  display: block;
  font-size: 22rpx;
  color: #b16f39;
}
