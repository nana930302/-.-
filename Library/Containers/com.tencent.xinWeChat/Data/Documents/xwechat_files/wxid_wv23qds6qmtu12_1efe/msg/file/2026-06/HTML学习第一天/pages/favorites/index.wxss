.favorites-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.favorite {
  padding: 30rpx;
}

.favorite__type {
  display: inline-flex;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 248, 239, 0.62);
  color: #804518;
  font-size: 22rpx;
  margin-bottom: 18rpx;
}

.favorite__name {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: #54200b;
  margin-bottom: 12rpx;
}

.favorite__tip {
  display: block;
  font-size: 26rpx;
  line-height: 1.7;
  color: rgba(84, 32, 11, 0.78);
}

.favorite__actions {
  display: flex;
  gap: 18rpx;
  margin-top: 24rpx;
}

.favorite__btn {
  flex: 1;
}

.favorite__btn--ghost {
  background: rgba(255, 248, 239, 0.75);
}
